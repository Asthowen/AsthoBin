{
    "name": "asthobin",
    "version": "0.2.1",
    "private": true,
    "description": "AsthoBin is a simple website to share pieces of code with a URL, written in Rust.",
    "homepage": "https://github.com/Asthowen/AsthoBin#README.md",
    "bugs": {
        "url": "https://github.com/Asthowen/AsthoBin/issues"
    },
