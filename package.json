        "oxfmt": "^0.74.0",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "prettier": "^3.9.10",
        "serve-static": "^2.2.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.5"
