    "author": "Asthowen <contact@asthowen.fr>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Asthowen/AsthoBin.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "oxlint frontend/ts vite.config.ts oxfmt.config.ts oxlint.config.ts",
        "fmt": "oxfmt 'frontend/{css,ts}/**/*.{css,ts}' '*.{json,ts}'",
        "bump-dependencies": "npm-check-updates -u && pnpm i"
    },
    "dependencies": {
        "highlight.js": "^11.12.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^26.6.6",
        "@types/serve-static": "^2.2.0",
        "jiti": "^2.7.0",
        "lightningcss": "^1.33.0",
        "npm-check-updates": "^23.1.1",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2007",
        "prettier": "^3.10.1",
        "serve-static": "^2.2.1",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.8"
    }
